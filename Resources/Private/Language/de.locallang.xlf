<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="messages"
          date="2025-01-01T00:00:00Z" product-name="mai_accessibility">
        <header/>
        <body>
            <trans-unit id="mlang_tabs_tab">
                <source>Accessibility</source>
                <target>Barrierefreiheit</target>
            </trans-unit>
            <trans-unit id="mlang_labels_tablabel">
                <source>Accessibility Analysis</source>
                <target>Barrierefreiheits-Analyse</target>
            </trans-unit>
            <trans-unit id="mlang_labels_tabdescr">
                <source>Scan your pages for common accessibility issues including missing alt texts, broken heading hierarchies, invalid ARIA attributes, and non-descriptive link texts.</source>
                <target>Durchsucht Ihre Seiten nach häufigen Barrierefreiheitsproblemen wie fehlenden Alt-Texten, fehlerhaften Überschriftenhierarchien, ungültigen ARIA-Attributen und nichtssagenden Linktexten.</target>
            </trans-unit>
            <trans-unit id="module.title">
                <source>Accessibility Analysis</source>
                <target>Barrierefreiheits-Analyse</target>
            </trans-unit>
            <trans-unit id="module.description">
                <source>Scan your pages for common accessibility issues including missing alt texts, broken heading hierarchies, invalid ARIA attributes, and non-descriptive link texts.</source>
                <target>Durchsucht Ihre Seiten nach häufigen Barrierefreiheitsproblemen wie fehlenden Alt-Texten, fehlerhaften Überschriftenhierarchien, ungültigen ARIA-Attributen und nichtssagenden Linktexten.</target>
            </trans-unit>

            <trans-unit id="scope.label">
                <source>Page Tree</source>
                <target>Seitenbaum</target>
            </trans-unit>
            <trans-unit id="scope.selected_page">
                <source>Selected page:</source>
                <target>Ausgewählte Seite:</target>
            </trans-unit>
            <trans-unit id="scope.select_page_hint">
                <source>Select a page in the page tree to see its subtree. You can then run an accessibility check against all pages in that subtree.</source>
                <target>Wählen Sie eine Seite im Seitenbaum aus, um deren Unterseiten anzuzeigen. Anschließend können Sie eine Barrierefreiheitsprüfung für alle Seiten in diesem Teilbaum durchführen.</target>
            </trans-unit>
            <trans-unit id="scope.all_pages">
                <source>All pages</source>
                <target>Alle Seiten</target>
            </trans-unit>
            <trans-unit id="scope.apply">
                <source>Apply</source>
                <target>Anwenden</target>
            </trans-unit>

            <trans-unit id="action.run_check">
                <source>Run Accessibility Check</source>
                <target>Barrierefreiheitsprüfung ausführen</target>
            </trans-unit>
            <trans-unit id="action.export_csv">
                <source>Export as CSV</source>
                <target>Als CSV exportieren</target>
            </trans-unit>
            <trans-unit id="action.back">
                <source>Back to Overview</source>
                <target>Zurück zur Übersicht</target>
            </trans-unit>

            <trans-unit id="pages.list.title">
                <source>Pages in Subtree</source>
                <target>Seiten im Teilbaum</target>
            </trans-unit>
            <trans-unit id="pages.column.title">
                <source>Title</source>
                <target>Titel</target>
            </trans-unit>
            <trans-unit id="pages.empty">
                <source>No published standard pages found in this subtree.</source>
                <target>Keine veröffentlichten Standardseiten in diesem Teilbaum gefunden.</target>
            </trans-unit>

            <trans-unit id="check.title">
                <source>Accessibility Check Results</source>
                <target>Ergebnisse der Barrierefreiheitsprüfung</target>
            </trans-unit>
            <trans-unit id="check.total_errors">
                <source>Errors</source>
                <target>Fehler</target>
            </trans-unit>
            <trans-unit id="check.total_warnings">
                <source>Warnings</source>
                <target>Warnungen</target>
            </trans-unit>
            <trans-unit id="check.page_heading">
                <source>Page</source>
                <target>Seite</target>
            </trans-unit>
            <trans-unit id="check.no_issues">
                <source>No accessibility issues found. Great work!</source>
                <target>Keine Barrierefreiheitsprobleme gefunden. Sehr gute Arbeit!</target>
            </trans-unit>

            <trans-unit id="result.column.check">
                <source>Check</source>
                <target>Prüfung</target>
            </trans-unit>
            <trans-unit id="result.column.severity">
                <source>Severity</source>
                <target>Schweregrad</target>
            </trans-unit>
            <trans-unit id="result.column.message">
                <source>Message</source>
                <target>Meldung</target>
            </trans-unit>
            <trans-unit id="result.column.context">
                <source>Context</source>
                <target>Kontext</target>
            </trans-unit>
        </body>
    </file>
</xliff>
